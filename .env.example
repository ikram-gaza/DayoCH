# URL de base de l'API (préfixe inclus). En développement, Vite relaie /api vers localhost:3000.
VITE_API_URL=/api/v1

# true (défaut) = authentification simulée en local
# false = appels réels vers le backend
VITE_USE_MOCK_AUTH=true

# true (défaut) = données métier simulées en local
# false = appels réels vers le backend pour les modules branchés (agents, trombinoscope,
# pilotage et organigramme du groupe)
VITE_USE_MOCK_DATA=true
