# URL appelée par le navigateur. En développement, Vite relaie /api vers le backend.
VITE_API_URL=/api/v1

# Cible du proxy Vite, surchargeable dans .env.local
API_PROXY_TARGET=http://localhost:3000

# true (défaut) = authentification simulée en local
# false = appels réels vers le backend via VITE_API_URL
VITE_USE_MOCK_AUTH=true

# true (défaut) = données métiers simulées en local
# false = appels réels vers le backend pour les modules migrés
VITE_USE_MOCK_DATA=true
