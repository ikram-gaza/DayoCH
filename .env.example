# URL de base de l'API (préfixe inclus). En développement, Vite relaie /api vers API_PROXY_TARGET.
VITE_API_URL=/api/v1

# Cible du proxy Vite pour /api en développement.
API_PROXY_TARGET=http://localhost:3000

# Laisser à false pour utiliser l'API backend réelle.
VITE_USE_MOCK_AUTH=false
VITE_USE_MOCK_DATA=false
